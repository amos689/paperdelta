include LICENSE *.md
include .gitattributes .gitignore
recursive-include .github *.yml *.md
recursive-include docs *.md *.json *.png *.webm *.log *.xml
include docs/evidence/macos-native-20261003/return.zip
recursive-include examples *.yaml *.yml *.tex *.csv *.json *.py *.pdf *.png *.md
recursive-include tools *.py *.cjs
recursive-include tests *.py
recursive-include evaluations *.md *.json *.tex *.csv *.yaml *.py *.css *.js
prune tests/corpus
exclude docs/evidence/corpus*.json
# Artifact hashes are sidecars, avoiding self-referential distribution contents.
exclude docs/evidence/package-audit*.json
exclude docs/evidence/release-replay*.json
prune examples/research-paper/build
prune examples/research-paper/.paperdelta
prune examples/ambiguous-table/build
prune examples/ambiguous-table/.paperdelta
prune examples/unicode-macro/build
prune examples/unicode-macro/.paperdelta
