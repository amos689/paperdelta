include LICENSE *.md
include docs/package-description.rst
include .gitattributes .gitignore
include action.yml
recursive-include .github *.yml *.md
recursive-include docs *.md *.json *.svg *.png *.gif *.webm *.log *.xml
include docs/evidence/macos-native-20261003/return.zip
recursive-include examples *.yaml *.yml *.tex *.csv *.tsv *.xlsx *.json *.py *.pdf *.png *.md *.qmd
recursive-include tools *.py *.cjs
recursive-include tests *.py
recursive-include evaluations *.md *.json *.tex *.csv *.yaml *.py *.css *.js
recursive-include validation/mapping-v4 *.md *.json *.tex *.csv *.yaml *.py *.css *.js *.log
recursive-include validation/mapping-v4 LICENSE
recursive-include validation/mapping-v5 *.md *.json *.tex *.csv *.tsv *.xlsx *.docx *.pdf *.png *.qmd *.yaml *.py *.css *.js *.ps1 *.log *.bin
recursive-include validation/mapping-v5 LICENSE
prune tests/corpus
prune validation/native-v1
prune validation/native-v2
prune validation/native-v3
exclude docs/evidence/corpus*.json
# Artifact hashes are sidecars, avoiding self-referential distribution contents.
exclude docs/evidence/package-audit*.json
exclude docs/evidence/release-replay*.json
prune examples/research-paper/build
prune examples/research-paper/.paperdelta
prune examples/ambiguous-table/build
prune examples/ambiguous-table/.paperdelta
prune examples/unicode-macro/build
prune examples/unicode-macro/.paperdelta
prune examples/evidence-native/build
prune examples/evidence-native/.paperdelta
prune examples/seed-statistics/build
prune examples/seed-statistics/.paperdelta
prune examples/static-manuscript/build
prune examples/static-manuscript/.paperdelta
